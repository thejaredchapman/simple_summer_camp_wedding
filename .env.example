# =============================================================================
# Camp Javery Wedding Server Configuration
# =============================================================================

# Anthropic API Key (REQUIRED)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Server Port (optional, defaults to 3001)
PORT=3001

# Environment (optional, defaults to 'development')
# Set to 'production' for deployment
NODE_ENV=development

# Allowed Origins for CORS (optional)
# Comma-separated list of allowed origins
# In development, defaults to localhost ports
# In production, set this to your actual domain(s)
# Example: ALLOWED_ORIGINS=https://campjavery.com,https://www.campjavery.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
